{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "93654c67d3a0406db9d2ede7f4ad318b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MoonPhase (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 40.99999237060547,
            "y": -2098.0,
            "width": 221.0001220703125,
            "height": 166.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "fbae53ce991f4c5b9ebac84c2ef4a210"
        },
        {
            "m_Id": "2a0e417c81794260a649b83f6a89ebeb"
        },
        {
            "m_Id": "25e8ffdac1094044a0baf858618f8c02"
        },
        {
            "m_Id": "9bfc25fb7f514aeba04396cb9d6b71e5"
        },
        {
            "m_Id": "bdf1227c350e47638f67720a0eaf9624"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MoonPhase",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 m = normalize(MoonDir);\nfloat3 r = normalize(cross(float3(0, 1, 0), m) + float3(0.00001, 0, 0));\nfloat3 u = cross(m, r);\n\nfloat2 p = float2(dot(Dir, r), dot(Dir, u)) / Radius;\nfloat d = length(p);\n\nfloat facing = step(0.0, dot(Dir, m));\nfloat disc = (1.0 - smoothstep(0.92, 1.0, d)) * facing;\n\nfloat z = sqrt(saturate(1.0 - d * d));\nfloat a = Phase * 6.2831853;\nfloat3 L = float3(sin(a), 0.0, cos(a));\nfloat lit = smoothstep(-0.02, 0.08, dot(float3(p, z), L));\n\nOut = disc * (lit);"
}

